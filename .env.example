DB_URL=jdbc:mysql://localhost:3306/sudam?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=
DB_PASSWORD=
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
JWT_SECRET=
# 계좌번호 암호화 키. Base64로 인코딩한 32바이트 (예: openssl rand -base64 32)
ACCOUNT_ENCRYPTION_KEY=
# 아래 두 키는 개발 서버(dev 프로파일)에서만 쓴다. 로컬 실행에는 필요 없다.
# 백엔드 주소 (예: https://api.example.com). 카카오 redirect-uri에 쓴다
APP_BASE_URL=
# 프론트 주소 (예: https://example.com). 로그인 성공 · 실패 리다이렉트에 쓴다
FRONT_BASE_URL=
# 시연용 가상 데이터. true면 부팅 때 만든다 (기본 false)
SUDAM_SEED_ENABLED=
# 시드 선생님 카카오 회원번호. 비우면 가짜 계정 seed-teacher-1
SUDAM_SEED_TEACHER_KAKAO_ID=
